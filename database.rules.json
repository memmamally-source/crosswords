{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9]{12}$/)",
        "meta": {
          ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['host', 'puzzle', 'title', 'createdAt', 'expiresAt', 'base']) && newData.child('createdAt').val() === now && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() <= now + 691200000 && newData.child('puzzle').isString() && newData.child('puzzle').val().matches(/^#\\/(daily|mini|brutal|play)\\//) && newData.child('puzzle').val().length <= 1000 && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('base').isNumber() && newData.child('base').val() >= 0",
          "host": { ".validate": "newData.isString()" },
          "puzzle": { ".validate": true },
          "title": { ".validate": true },
          "createdAt": { ".validate": true },
          "expiresAt": { ".validate": true },
          "base": { ".validate": true },
          "$other": { ".validate": false }
        },
        "slots": {
          "$n": {
            ".write": "auth != null && newData.parent().parent().child('meta/expiresAt').val() > now && !root.child('rooms/' + $room + '/banned/' + auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && newData.parent().parent().child('meta/host').val() === auth.uid))",
            ".validate": "$n.matches(/^[1-5]$/) && newData.hasChildren(['uid', 'name']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().matches(/^[A-Za-z0-9 .'-]{1,20}$/)",
            "uid": { ".validate": true },
            "name": { ".validate": true },
            "joinedAt": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "$other": { ".validate": false }
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || newData.parent().parent().child('meta/host').val() === auth.uid)",
            ".validate": "newData.isNumber() && newData.parent().parent().child('slots/' + newData.val() + '/uid').val() === $uid"
          }
        },
        "banned": {
          "$uid": {
            ".write": "auth != null && newData.parent().parent().child('meta/host').val() === auth.uid && $uid !== auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "cells": {
          "$cell": {
            ".write": "auth != null && newData.parent().parent().child('members/' + auth.uid).exists() && newData.parent().parent().child('meta/expiresAt').val() > now && !newData.parent().parent().child('banned/' + auth.uid).exists()",
            ".validate": "$cell.matches(/^[0-9]{1,2}_[0-9]{1,2}$/) && newData.hasChildren(['v', 'by']) && newData.child('v').isString() && newData.child('v').val().matches(/^[A-Z]$/) && newData.child('by').val() === auth.uid",
            "v": { ".validate": true },
            "by": { ".validate": true },
            "rev": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && (($uid === auth.uid && (!newData.exists() || newData.parent().parent().child('members/' + auth.uid).exists())) || (!newData.exists() && newData.parent().parent().child('meta/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['r', 'c', 'd']) && newData.child('r').isNumber() && newData.child('c').isNumber() && newData.child('d').val().matches(/^(across|down)$/)",
            "r": { ".validate": true },
            "c": { ".validate": true },
            "d": { ".validate": true },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "hints": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && newData.parent().parent().child('members/' + auth.uid).exists()",
            "letter": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "word": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "checks": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "autocheck": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
